{
  "uid": "lab-hardware",
  "title": "Observatory / Hardware and memory",
  "schemaVersion": 40,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "tags": [
    "llm",
    "hardware",
    "measured"
  ],
  "panels": [
    {
      "id": 1,
      "title": "Process CPU · cores consumed",
      "description": "One core fully busy = 1.0. Measured service process, not per-request GPU utilization.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "rate(lab_resource_process_cpu_seconds_total[1m])",
          "refId": "A",
          "legendFormat": "{{service}} / {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "title": "Process resident RAM",
      "description": "RSS per service. This is real host memory, not modeled KV or GPU memory.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "lab_resource_process_rss_bytes",
          "refId": "A",
          "legendFormat": "{{service}} / {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "title": "Host-visible available RAM",
      "description": "Host-visible available RAM. Multiple containers may observe the same host: do not sum these series.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "lab_resource_host_memory_available_bytes",
          "refId": "A",
          "legendFormat": "{{service}} / {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "title": "Container memory · fraction of local limit",
      "description": "Cgroup v2 namespace root, typically this Docker container. Missing or unlimited limits produce no series. Ancestor and cpuset limits are not resolved.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "lab_resource_cgroup_namespace_root_memory_current_bytes / lab_resource_cgroup_namespace_root_memory_limit_bytes",
          "refId": "A",
          "legendFormat": "{{service}} / {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "title": "Container CPU quota · cores",
      "description": "Quota/period at the cgroup namespace root. Not CPU count or utilization. No series if unlimited or unavailable.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "lab_resource_cgroup_namespace_root_cpu_quota_cores",
          "refId": "A",
          "legendFormat": "{{service}} / {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "title": "Container CPU throttling · seconds / second",
      "description": "Throttled time at namespace root. Not per-request latency or a normalized CPU utilization percentage.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "rate(lab_resource_cgroup_namespace_root_cpu_throttled_seconds_total[1m])",
          "refId": "A",
          "legendFormat": "{{service}} / {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "title": "GPU memory allocated · external DCGM",
      "description": "DCGM framebuffer used is MiB, converted to bytes. VRAM is not always HBM. Device aggregate includes other processes; no data until external target is configured.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "(DCGM_FI_DEV_FB_USED >= 0 and DCGM_FI_DEV_FB_USED < 1000000000) * 1048576",
          "refId": "A",
          "legendFormat": "{{instance}} / GPU {{gpu}} / {{role}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "title": "GPU utilization · external DCGM",
      "description": "Coarse device activity percentage, not achieved FLOP/s or a bottleneck diagnosis.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "DCGM_FI_DEV_GPU_UTIL >= 0 and DCGM_FI_DEV_GPU_UTIL <= 100",
          "refId": "A",
          "legendFormat": "{{instance}} / GPU {{gpu}} / {{role}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 9,
      "title": "GPU DRAM activity · external DCGM",
      "description": "Fraction of memory-active cycles, NOT GB/s or fraction of peak bandwidth. Availability depends on GPU and profiling permissions.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "DCGM_FI_PROF_DRAM_ACTIVE >= 0 and DCGM_FI_PROF_DRAM_ACTIVE <= 1",
          "refId": "A",
          "legendFormat": "{{instance}} / GPU {{gpu}} / {{role}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 10,
      "title": "GPU SM activity · external DCGM",
      "description": "Active SM fraction; warps may be waiting for memory. Correlate with engine phases and memory activity.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "DCGM_FI_PROF_SM_ACTIVE >= 0 and DCGM_FI_PROF_SM_ACTIVE <= 1",
          "refId": "A",
          "legendFormat": "{{instance}} / GPU {{gpu}} / {{role}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 11,
      "title": "Resource sample age",
      "description": "Samples update every 2 seconds independently of requests. Short requests may be missed.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "lab_resource_sample_age_seconds",
          "refId": "A",
          "legendFormat": "{{service}} / {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 12,
      "title": "Real engine KV-cache pool utilization",
      "description": "Fraction of engine-managed KV pool, not fraction of all GPU memory. Requires private engine target. Metric depends on engine version.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "vllm:kv_cache_usage_perc >= 0 and vllm:kv_cache_usage_perc <= 1",
          "refId": "A",
          "legendFormat": "{{instance}} / GPU {{gpu}} / {{role}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ]
}
