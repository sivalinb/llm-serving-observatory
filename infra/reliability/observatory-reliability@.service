[Unit]
Description=Bounded Observatory reliability %i
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/etc/observatory-reliability
EnvironmentFile=/etc/observatory-reliability/runtime.env
ExecStart=/usr/bin/docker compose --env-file /etc/observatory-reliability/runtime.env -f /etc/observatory-reliability/compose.worker.yaml run --rm --no-deps --pull never reliability --config /private/config.json %i
TimeoutStartSec=180
TimeoutStopSec=15
UMask=0077
# The root Docker client needs its normal SELinux domain transition on Oracle Linux.
# NoNewPrivileges here blocks Docker-socket access; the WORKER retains no-new-privileges.
# This service already has host-root Docker authority, not a container sandbox.
ProtectHome=read-only
ProtectSystem=strict
PrivateTmp=true
# The client talks to Docker; container limits/hardening are in compose.reliability.yaml.
# No SDK credentials or Docker socket are mounted in the worker container.
# The root-owned environment file is OUTSIDE the worker's writable /private mount.
