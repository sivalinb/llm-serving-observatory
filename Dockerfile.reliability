FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /app
COPY requirements-reliability.lock ./
RUN pip install --no-cache-dir -r requirements-reliability.lock && useradd --uid 10001 --create-home runner
COPY observatory/__init__.py observatory/reliability.py ./observatory/
USER 10001:10001
ENTRYPOINT ["python", "-m", "observatory.reliability"]
